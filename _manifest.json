{
  "manifest_version": 2,
  "id": "local.whale-style",
  "version": "0.1.1",
  "name": "小鲸鱼表达学习",
  "description": "从 B站 素材里提炼可复用的表达经验，按场景小比例注入回复提示；只学结构，不学事实、称呼与关系。",
  "author": {
    "name": "idonotl",
    "url": "https://github.com/idonotl"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/idonotl/maibot-whale-style",
    "homepage": "https://github.com/idonotl/maibot-whale-style",
    "documentation": "https://github.com/idonotl/maibot-whale-style/blob/main/README.md",
    "issues": "https://github.com/idonotl/maibot-whale-style/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.19"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "extension",
  "dependencies": [],
  "capabilities": [
    "message.get_by_id",
    "llm.generate",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
